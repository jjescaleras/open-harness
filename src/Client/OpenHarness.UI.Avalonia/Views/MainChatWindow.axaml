<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenHarness.UI.Avalonia.ViewModels"
        xmlns:views="using:OpenHarness.UI.Avalonia.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
        Width="1400" Height="900"
        WindowStartupLocation="CenterScreen"
        x:Class="OpenHarness.UI.Avalonia.Views.MainChatWindow"
        x:DataType="vm:HarnessShellViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Open Harness - Agentic Engineering Workspace"
        Background="{StaticResource ArmoniaBgPrimaryBrush}">

    <Design.DataContext>
        <vm:HarnessShellViewModel />
    </Design.DataContext>

    <views:HarnessShellView />
</Window>
