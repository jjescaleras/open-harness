<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenHarness.UI.Avalonia.ViewModels"
        xmlns:i18n="using:OpenHarness.UI.Avalonia.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        x:Class="OpenHarness.UI.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{i18n:Tr Shell_WindowTitle}"
        Background="{StaticResource ArmoniaBgPrimaryBrush}">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="ToggleButton.panel-toggle, Button.panel-close">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource ArmoniaTextSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource ArmoniaRadiusMedium}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="{StaticResource ArmoniaFontSizeLg}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.panel-toggle:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ArmoniaBgElevatedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ArmoniaAccentPrimaryBrush}" />
        </Style>
        <Style Selector="Button.panel-close">
            <Setter Property="FontSize" Value="{StaticResource ArmoniaFontSizeXs}" />
        </Style>

        <Style Selector="Button.menu-item">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource ArmoniaTextSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource ArmoniaRadiusMedium}" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style Selector="Button.menu-item:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ArmoniaBgElevatedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ArmoniaTextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.submenu-item">
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style Selector="Border.submenu">
            <Setter Property="Background" Value="{StaticResource ArmoniaBgPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ArmoniaBorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource ArmoniaRadiusMedium}" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="16,4,0,0" />
        </Style>
        <Style Selector="Border.soon-badge">
            <Setter Property="Background" Value="{StaticResource ArmoniaBgElevatedBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource ArmoniaRadiusSmall}" />
            <Setter Property="Padding" Value="6,1" />
        </Style>
        <Style Selector="Border.soon-badge > TextBlock">
            <Setter Property="FontSize" Value="{StaticResource ArmoniaFontSizeXs}" />
            <Setter Property="Foreground" Value="{StaticResource ArmoniaTextMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.chevron">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource ArmoniaTextMutedBrush}" />
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
        </Style>
        <Style Selector="TextBlock.chevron.expanded">
            <Setter Property="RenderTransform" Value="rotate(90deg)" />
        </Style>
        <Style Selector="Button.menu-item.selected">
            <Setter Property="Background" Value="{StaticResource ArmoniaBgElevatedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ArmoniaAccentPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *">
        <!-- ============================================== -->
        <!-- HEADER: PANEL TOGGLES, BRAND & PRIMARY ACTION  -->
        <!-- ============================================== -->
        <Border Grid.Row="0"
                Background="{StaticResource ArmoniaBgSecondaryBrush}"
                BorderBrush="{StaticResource ArmoniaBorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                <ToggleButton Grid.Column="0"
                              IsChecked="{Binding IsMenuPanelVisible}"
                              HotKey="Ctrl+B"
                              ToolTip.Tip="{i18n:Tr Shell_ToggleMenu_Tooltip}"
                              Classes="panel-toggle"
                              Margin="0,0,12,0">
                    <TextBlock Text="☰" />
                </ToggleButton>

                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="⚡" FontSize="18" Foreground="{StaticResource ArmoniaAccentPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="OPEN HARNESS"
                                   FontWeight="Bold"
                                   FontSize="{StaticResource ArmoniaFontSizeLg}"
                                   Foreground="{StaticResource ArmoniaTextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Breadcrumb, StringFormat='/ {0}'}"
                                   FontSize="{StaticResource ArmoniaFontSizeLg}"
                                   Foreground="{StaticResource ArmoniaTextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding UserEmail}"
                               FontSize="{StaticResource ArmoniaFontSizeXs}"
                               Foreground="{StaticResource ArmoniaTextMutedBrush}" />
                </StackPanel>

                <Button Grid.Column="2"
                        Command="{Binding OpenChatCommand}"
                        HotKey="Ctrl+K"
                        ToolTip.Tip="{i18n:Tr Shell_OpenChat_Tooltip}"
                        Background="{StaticResource ArmoniaAccentPrimaryBrush}"
                        Foreground="{StaticResource ArmoniaTextPrimaryBrush}"
                        FontWeight="SemiBold"
                        CornerRadius="{StaticResource ArmoniaRadiusMedium}"
                        Padding="16,8"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="💬" VerticalAlignment="Center" />
                        <TextBlock Text="{i18n:Tr Shell_OpenChat}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <ToggleButton Grid.Column="3"
                              IsChecked="{Binding IsAuxPanelVisible}"
                              HotKey="Ctrl+J"
                              ToolTip.Tip="{i18n:Tr Shell_ToggleAuxPanel_Tooltip}"
                              Classes="panel-toggle"
                              Margin="12,0,0,0">
                    <TextBlock Text="◨" />
                </ToggleButton>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto">
            <!-- ============================================== -->
            <!-- RIGHT: MULTI-PURPOSE PANEL (HIDDEN BY DEFAULT) -->
            <!-- ============================================== -->
            <Border Grid.Column="2"
                    Width="300"
                    IsVisible="{Binding IsAuxPanelVisible}"
                    Background="{StaticResource ArmoniaBgSecondaryBrush}"
                    BorderBrush="{StaticResource ArmoniaBorderSubtleBrush}"
                    BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto, *">
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="16,12">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding AuxPanelTitle}"
                                   FontWeight="SemiBold"
                                   FontSize="{StaticResource ArmoniaFontSizeSm}"
                                   Foreground="{StaticResource ArmoniaTextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Command="{Binding ToggleAuxPanelCommand}"
                                ToolTip.Tip="{i18n:Tr Shell_AuxPanel_Hide}"
                                Classes="panel-close">
                            <TextBlock Text="✕" />
                        </Button>
                    </Grid>
                    <Panel Grid.Row="1" Margin="16,0,16,16">
                        <ContentControl Content="{Binding AuxPanelContent}" />
                        <TextBlock IsVisible="{Binding AuxPanelContent, Converter={x:Static ObjectConverters.IsNull}}"
                                   Text="{i18n:Tr Shell_AuxPanel_Placeholder}"
                                   TextWrapping="Wrap"
                                   FontSize="{StaticResource ArmoniaFontSizeXs}"
                                   Foreground="{StaticResource ArmoniaTextMutedBrush}" />
                    </Panel>
                </Grid>
            </Border>

            <!-- ============================================== -->
            <!-- CENTER: SELECTED PAGE                          -->
            <!-- ============================================== -->
            <ScrollViewer Grid.Column="1" Padding="24" IsVisible="{Binding IsDashboardSelected}">

                <StackPanel Spacing="24">
                    <!-- Sample data notice -->
                    <Border IsVisible="{Binding IsSampleData}"
                            Background="{StaticResource ArmoniaBgElevatedBrush}"
                            BorderBrush="{StaticResource ArmoniaWarningBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource ArmoniaRadiusMedium}"
                            Padding="12,8">
                        <TextBlock Text="{i18n:Tr Dashboard_SampleDataNotice}"
                                   FontSize="{StaticResource ArmoniaFontSizeXs}"
                                   Foreground="{StaticResource ArmoniaWarningBrush}" />
                    </Border>

                    <!-- KPI cards -->
                    <ItemsControl ItemsSource="{Binding Kpis}" Margin="0,0,-12,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:DashboardKpiViewModel">
                                <Border Background="{StaticResource ArmoniaBgSecondaryBrush}"
                                        BorderBrush="{StaticResource ArmoniaBorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource ArmoniaRadiusLarge}"
                                        Padding="16"
                                        Margin="0,0,12,0">
                                    <Grid ColumnDefinitions="4, *">
                                        <Border Grid.Column="0"
                                                Background="{Binding AccentColor}"
                                                CornerRadius="{StaticResource ArmoniaRadiusFull}" />
                                        <StackPanel Grid.Column="1" Spacing="4" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="{StaticResource ArmoniaFontSizeXs}"
                                                       Foreground="{StaticResource ArmoniaTextSecondaryBrush}" />
                                            <TextBlock Text="{Binding Value}"
                                                       FontWeight="Bold"
                                                       FontSize="{StaticResource ArmoniaFontSizeXxl}"
                                                       Foreground="{StaticResource ArmoniaTextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Caption}"
                                                       FontSize="{StaticResource ArmoniaFontSizeXs}"
                                                       Foreground="{StaticResource ArmoniaTextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Recent sessions -->
                    <Border Background="{StaticResource ArmoniaBgSecondaryBrush}"
                            BorderBrush="{StaticResource ArmoniaBorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource ArmoniaRadiusLarge}"
                            Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{i18n:Tr Dashboard_RecentSessions}"
                                       FontWeight="SemiBold"
                                       FontSize="{StaticResource ArmoniaFontSizeXs}"
                                       Foreground="{StaticResource ArmoniaTextSecondaryBrush}" />
                            <ItemsControl ItemsSource="{Binding RecentSessions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:SessionItemViewModel">
                                        <Border Background="{StaticResource ArmoniaBgElevatedBrush}"
                                                CornerRadius="{StaticResource ArmoniaRadiusMedium}"
                                                Padding="12,10"
                                                Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="*, Auto, Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           FontSize="{StaticResource ArmoniaFontSizeSm}"
                                                           Foreground="{StaticResource ArmoniaTextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding UpdatedAt, StringFormat='{}{0:MM/dd HH:mm}'}"
                                                           FontSize="{StaticResource ArmoniaFontSizeXs}"
                                                           Foreground="{StaticResource ArmoniaTextMutedBrush}"
                                                           Margin="12,0"
                                                           VerticalAlignment="Center" />
                                                <Border Grid.Column="2"
                                                        Background="{StaticResource ArmoniaBgSecondaryBrush}"
                                                        CornerRadius="{StaticResource ArmoniaRadiusSmall}"
                                                        Padding="6,2">
                                                    <TextBlock Text="{Binding Status}"
                                                               FontSize="{StaticResource ArmoniaFontSizeXs}"
                                                               Foreground="{Binding StatusBadgeColor}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Pages other than the dashboard (settings, coming-soon placeholders) -->
            <ContentControl Grid.Column="1"
                            IsVisible="{Binding !IsDashboardSelected}"
                            Content="{Binding CurrentPage}" />

            <!-- ============================================== -->
            <!-- LEFT: MENU PANEL (COLLAPSIBLE)                 -->
            <!-- ============================================== -->
            <Border Grid.Column="0"
                    Width="240"
                    IsVisible="{Binding IsMenuPanelVisible}"
                    Background="{StaticResource ArmoniaBgSecondaryBrush}"
                    BorderBrush="{StaticResource ArmoniaBorderSubtleBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="12,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="{i18n:Tr Menu_Header}"
                               FontWeight="SemiBold"
                               FontSize="{StaticResource ArmoniaFontSizeXs}"
                               Foreground="{StaticResource ArmoniaTextSecondaryBrush}"
                               Margin="4,0,0,4" />
                    <ItemsControl ItemsSource="{Binding MenuItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:NavigationItemViewModel">
                                <StackPanel Margin="0,0,0,4">
                                    <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="menu-item"
                                            Classes.selected="{Binding IsSelected}">
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" Width="24" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       FontSize="{StaticResource ArmoniaFontSizeSm}"
                                                       VerticalAlignment="Center" />
                                            <Border Grid.Column="2"
                                                    IsVisible="{Binding !IsAvailable}"
                                                    Classes="soon-badge">
                                                <TextBlock Text="{i18n:Tr Menu_Soon}" />
                                            </Border>
                                            <TextBlock Grid.Column="2"
                                                       IsVisible="{Binding HasChildren}"
                                                       Text="▸"
                                                       Classes="chevron"
                                                       Classes.expanded="{Binding IsExpanded}" />
                                        </Grid>
                                    </Button>

                                    <!-- Nested sub-menu (e.g. Configuración › General / Conexiones / Modelos) -->
                                    <Border Classes="submenu">
                                        <Border.IsVisible>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="HasChildren" />
                                                <Binding Path="IsExpanded" />
                                            </MultiBinding>
                                        </Border.IsVisible>
                                        <ItemsControl ItemsSource="{Binding Children}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:NavigationItemViewModel">
                                                    <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateCommand}"
                                                            CommandParameter="{Binding}"
                                                            Classes="menu-item submenu-item"
                                                            Classes.selected="{Binding IsSelected}"
                                                            Margin="0,0,0,2">
                                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" Width="22" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Title}"
                                                                       FontSize="{StaticResource ArmoniaFontSizeSm}"
                                                                       VerticalAlignment="Center" />
                                                            <Border Grid.Column="2"
                                                                    IsVisible="{Binding !IsAvailable}"
                                                                    Classes="soon-badge">
                                                                <TextBlock Text="{i18n:Tr Menu_Soon}" />
                                                            </Border>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
