<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:OpenHarness.UI.Avalonia.ViewModels"
             xmlns:views="using:OpenHarness.UI.Avalonia.Views"
             xmlns:controls="using:OpenHarness.UI.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="OpenHarness.UI.Avalonia.Views.HarnessShellView"
             x:DataType="vm:HarnessShellViewModel"
             Background="{StaticResource ArmoniaBgPrimaryBrush}">

    <Grid ColumnDefinitions="280, *, 380">
        <!-- ============================================== -->
        <!-- PANEL 1: LEFT PANEL (SESSIONS & NAVIGATION)   -->
        <!-- ============================================== -->
        <Border Grid.Column="0"
                Background="{StaticResource ArmoniaBgSecondaryBrush}"
                BorderBrush="{StaticResource ArmoniaBorderSubtleBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto, Auto, *, Auto">
                <!-- App Brand / Header -->
                <Border Grid.Row="0" Padding="16,16,16,12"
                        BorderBrush="{StaticResource ArmoniaBorderSubtleBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="⚡" FontSize="18" Foreground="{StaticResource ArmoniaAccentPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="OPEN HARNESS"
                                       FontWeight="Bold"
                                       FontSize="{StaticResource ArmoniaFontSizeLg}"
                                       Foreground="{StaticResource ArmoniaTextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Agentic Sandbox Environment"
                                   FontSize="{StaticResource ArmoniaFontSizeXs}"
                                   Foreground="{StaticResource ArmoniaTextMutedBrush}" />
                    </StackPanel>
                </Border>

                <!-- Actions: New Session & Refresh -->
                <Border Grid.Row="1" Padding="16,12"
                        BorderBrush="{StaticResource ArmoniaBorderSubtleBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*, Auto">
                        <Button Grid.Column="0"
                                Command="{Binding CreateNewSessionCommand}"
                                Background="{StaticResource ArmoniaAccentPrimaryBrush}"
                                Foreground="{StaticResource ArmoniaTextPrimaryBrush}"
                                FontWeight="SemiBold"
                                CornerRadius="{StaticResource ArmoniaRadiusMedium}"
                                Padding="12,8"
                                Margin="0,0,8,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="+" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="New Session" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                Command="{Binding RefreshSessionsCommand}"
                                Background="{StaticResource ArmoniaBgElevatedBrush}"
                                BorderBrush="{StaticResource ArmoniaBorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource ArmoniaRadiusMedium}"
                                Padding="10,8"
                                ToolTip.Tip="Refresh sessions list">
                            <TextBlock Text="↻" FontSize="14" Foreground="{StaticResource ArmoniaTextSecondaryBrush}" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Sessions List -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ListBox ItemsSource="{Binding Sessions}"
                             SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                             Background="Transparent"
                             Padding="8">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:SessionItemViewModel">
                                <Border Background="{StaticResource ArmoniaBgElevatedBrush}"
                                        BorderBrush="{StaticResource ArmoniaBorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource ArmoniaRadiusMedium}"
                                        Padding="12,10"
                                        Margin="0,0,0,8">
                                    <Grid RowDefinitions="Auto, Auto">
                                        <!-- Title and Status -->
                                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       FontSize="{StaticResource ArmoniaFontSizeSm}"
                                                       Foreground="{StaticResource ArmoniaTextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1"
                                                    Background="{StaticResource ArmoniaBgSecondaryBrush}"
                                                    CornerRadius="{StaticResource ArmoniaRadiusSmall}"
                                                    Padding="6,2">
                                                <TextBlock Text="{Binding Status}"
                                                           FontSize="{StaticResource ArmoniaFontSizeXs}"
                                                           Foreground="{StaticResource ArmoniaAccentPrimaryBrush}" />
                                            </Border>
                                        </Grid>

                                        <!-- Tokens and Time -->
                                        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,6,0,0">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding TotalTokensFormatted}"
                                                       FontSize="{StaticResource ArmoniaFontSizeXs}"
                                                       Foreground="{StaticResource ArmoniaTextMutedBrush}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding UpdatedAt, StringFormat='{}{0:MM/dd HH:mm}'}"
                                                       FontSize="{StaticResource ArmoniaFontSizeXs}"
                                                       Foreground="{StaticResource ArmoniaTextMutedBrush}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <!-- User Profile Section -->
                <Border Grid.Row="3"
                        Background="{StaticResource ArmoniaBgElevatedBrush}"
                        BorderBrush="{StaticResource ArmoniaBorderSubtleBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16,12">
                    <Grid ColumnDefinitions="Auto, *">
                        <Border Grid.Column="0"
                                Width="32" Height="32"
                                CornerRadius="{StaticResource ArmoniaRadiusFull}"
                                Background="{StaticResource ArmoniaAccentPrimaryBrush}"
                                Margin="0,0,10,0">
                            <TextBlock Text="👤" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserEmail}"
                                       FontWeight="SemiBold"
                                       FontSize="{StaticResource ArmoniaFontSizeXs}"
                                       Foreground="{StaticResource ArmoniaTextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding UserRole}"
                                       FontSize="{StaticResource ArmoniaFontSizeXs}"
                                       Foreground="{StaticResource ArmoniaSuccessBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!-- PANEL 2: CENTER PANEL (CONVERSATION & PROMPT)  -->
        <!-- ============================================== -->
        <Grid Grid.Column="1" RowDefinitions="Auto, *">
            <!-- Active Session Header -->
            <Border Grid.Row="0"
                    Background="{StaticResource ArmoniaBgSecondaryBrush}"
                    BorderBrush="{StaticResource ArmoniaBorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,14">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding SelectedSession.Title, FallbackValue='Select a Session'}"
                                   FontWeight="Bold"
                                   FontSize="{StaticResource ArmoniaFontSizeLg}"
                                   Foreground="{StaticResource ArmoniaTextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <Border Background="{StaticResource ArmoniaBgElevatedBrush}"
                                BorderBrush="{StaticResource ArmoniaBorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource ArmoniaRadiusSmall}"
                                Padding="8,3"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedSession.Status, FallbackValue='Idle'}"
                                       FontSize="{StaticResource ArmoniaFontSizeXs}"
                                       Foreground="{StaticResource ArmoniaAccentPrimaryBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- Stats Counter -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Tokens:"
                                       FontSize="{StaticResource ArmoniaFontSizeXs}"
                                       Foreground="{StaticResource ArmoniaTextMutedBrush}" />
                            <TextBlock Text="{Binding SelectedSession.TotalTokensFormatted, FallbackValue='0 tok'}"
                                       FontWeight="SemiBold"
                                       FontSize="{StaticResource ArmoniaFontSizeXs}"
                                       Foreground="{StaticResource ArmoniaTextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Chat Conversation View -->
            <views:ChatStreamView Grid.Row="1"
                                  DataContext="{Binding ChatStream}" />
        </Grid>

        <!-- ============================================== -->
        <!-- PANEL 3: RIGHT PANEL (INSPECTOR & DIFF VIEWER) -->
        <!-- ============================================== -->
        <Border Grid.Column="2"
                Background="{StaticResource ArmoniaBgSecondaryBrush}"
                BorderBrush="{StaticResource ArmoniaBorderSubtleBrush}"
                BorderThickness="1,0,0,0">
            <Grid RowDefinitions="Auto, Auto, 180, *">
                <!-- Inspector Header -->
                <Border Grid.Row="0"
                        Background="{StaticResource ArmoniaBgElevatedBrush}"
                        BorderBrush="{StaticResource ArmoniaBorderSubtleBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🛠️" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="Inspector &amp; Telemetry"
                                   FontWeight="Bold"
                                   FontSize="{StaticResource ArmoniaFontSizeMd}"
                                   Foreground="{StaticResource ArmoniaTextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Pending Approval Alert Banner (when action required) -->
                <Border Grid.Row="1"
                        IsVisible="{Binding HasPendingApproval}"
                        Background="{StaticResource ArmoniaDiffRemovedBgBrush}"
                        BorderBrush="{StaticResource ArmoniaDangerBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,10">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Sandbox Approval Required"
                                       FontWeight="Bold"
                                       FontSize="{StaticResource ArmoniaFontSizeSm}"
                                       Foreground="{StaticResource ArmoniaDangerBrush}" />
                            <TextBlock Text="An agent tool is paused awaiting authorization."
                                       FontSize="{StaticResource ArmoniaFontSizeXs}"
                                       Foreground="{StaticResource ArmoniaTextSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Background="{StaticResource ArmoniaDangerBrush}"
                                Foreground="{StaticResource ArmoniaTextPrimaryBrush}"
                                FontWeight="Bold"
                                FontSize="{StaticResource ArmoniaFontSizeXs}"
                                CornerRadius="{StaticResource ArmoniaRadiusSmall}"
                                Padding="10,6"
                                VerticalAlignment="Center"
                                Content="Authorize" />
                    </Grid>
                </Border>

                <!-- Tool Executions List -->
                <Border Grid.Row="2"
                        BorderBrush="{StaticResource ArmoniaBorderSubtleBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid RowDefinitions="Auto, *">
                        <TextBlock Grid.Row="0"
                                   Text="TOOL EXECUTIONS"
                                   FontWeight="Bold"
                                   FontSize="{StaticResource ArmoniaFontSizeXs}"
                                   Foreground="{StaticResource ArmoniaTextMutedBrush}"
                                   Margin="14,10,14,6" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ListBox ItemsSource="{Binding ToolExecutions}"
                                     SelectedItem="{Binding SelectedToolExecution, Mode=TwoWay}"
                                     Background="Transparent"
                                     Padding="8,4">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="vm:ToolExecutionItemViewModel">
                                        <Border Background="{StaticResource ArmoniaBgElevatedBrush}"
                                                BorderBrush="{StaticResource ArmoniaBorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource ArmoniaRadiusSmall}"
                                                Padding="10,6"
                                                Margin="0,0,0,4">
                                            <Grid ColumnDefinitions="*, Auto, Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding ToolName}"
                                                           FontWeight="SemiBold"
                                                           FontSize="{StaticResource ArmoniaFontSizeSm}"
                                                           Foreground="{StaticResource ArmoniaTextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DurationFormatted}"
                                                           FontSize="{StaticResource ArmoniaFontSizeXs}"
                                                           Foreground="{StaticResource ArmoniaTextMutedBrush}"
                                                           Margin="8,0" />
                                                <Border Grid.Column="2"
                                                        Background="{StaticResource ArmoniaBgSecondaryBrush}"
                                                        CornerRadius="{StaticResource ArmoniaRadiusSmall}"
                                                        Padding="4,2">
                                                    <TextBlock Text="{Binding Status}"
                                                               FontSize="{StaticResource ArmoniaFontSizeXs}"
                                                               Foreground="{StaticResource ArmoniaAccentPrimaryBrush}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Diff and Output Viewer -->
                <controls:DiffEditorControl Grid.Row="3"
                                           DataContext="{Binding DiffEditor}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

