<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:vm="using:OpenHarness.UI.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="OpenHarness.UI.Avalonia.Controls.DiffEditorControl"
             x:DataType="vm:DiffEditorViewModel"
             Background="{StaticResource ArmoniaBgSecondaryBrush}">

    <Grid RowDefinitions="Auto, *">
        <!-- Header with file path and diff statistics -->
        <Border Grid.Row="0"
                Background="{StaticResource ArmoniaBgElevatedBrush}"
                BorderBrush="{StaticResource ArmoniaBorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="📄" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding FilePath}"
                               FontWeight="SemiBold"
                               FontSize="{StaticResource ArmoniaFontSizeSm}"
                               Foreground="{StaticResource ArmoniaTextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Diff badges (+added / -removed) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsDiffMode}">
                    <Border Background="{StaticResource ArmoniaDiffAddedBgBrush}"
                            CornerRadius="{StaticResource ArmoniaRadiusSmall}"
                            Padding="6,2">
                        <TextBlock Text="{Binding AddedLinesCount, StringFormat='+{0}'}"
                                   Foreground="{StaticResource ArmoniaDiffAddedTextBrush}"
                                   FontWeight="Bold"
                                   FontSize="{StaticResource ArmoniaFontSizeXs}" />
                    </Border>
                    <Border Background="{StaticResource ArmoniaDiffRemovedBgBrush}"
                            CornerRadius="{StaticResource ArmoniaRadiusSmall}"
                            Padding="6,2">
                        <TextBlock Text="{Binding RemovedLinesCount, StringFormat='-{0}'}"
                                   Foreground="{StaticResource ArmoniaDiffRemovedTextBrush}"
                                   FontWeight="Bold"
                                   FontSize="{StaticResource ArmoniaFontSizeXs}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- AvaloniaEdit Code/Diff Viewer -->
        <avaloniaEdit:TextEditor Grid.Row="1"
                                 x:Name="Editor"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontFamily="Consolas, Menlo, Cascadia Code, Courier New, Monospace"
                                 FontSize="13"
                                 Background="{StaticResource ArmoniaBgPrimaryBrush}"
                                 Foreground="{StaticResource ArmoniaTextPrimaryBrush}"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="8" />
    </Grid>
</UserControl>

