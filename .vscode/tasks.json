{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "OpenHarness.slnx",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "test",
      "command": "dotnet",
      "type": "process",
      "args": [
        "test",
        "OpenHarness.slnx",
        "--logger",
        "console;verbosity=normal"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Run Backend (OpenHarness.Api)",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "src/Backend/OpenHarness.Api/OpenHarness.Api.csproj"
      ],
      "problemMatcher": "$msCompile",
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated"
      }
    },
    {
      "label": "Watch Backend (Hot Reload)",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "--project",
        "src/Backend/OpenHarness.Api/OpenHarness.Api.csproj"
      ],
      "problemMatcher": "$msCompile",
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated"
      }
    },
    {
      "label": "Run Frontend (OpenHarness.UI.Avalonia)",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "src/Client/OpenHarness.UI.Avalonia/OpenHarness.UI.Avalonia.csproj"
      ],
      "problemMatcher": "$msCompile",
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated"
      }
    },
    {
      "label": "Start Database (PostgreSQL 17 / pgvector)",
      "command": "docker",
      "type": "shell",
      "args": [
        "compose",
        "up",
        "-d"
      ],
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Stop Database",
      "command": "docker",
      "type": "shell",
      "args": [
        "compose",
        "down"
      ],
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    }
  ]
}
